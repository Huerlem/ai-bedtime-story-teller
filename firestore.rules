rules_version = '2';

// Dream Tales V2 — Firestore security rules
//
// Model (legacy-compatible):
//   users/{uid}            parent profile; familyId MUST equal uid (one family per parent)
//   users/{childProfileId} child profile document created by the parent; it is NOT a
//                          Firebase Auth account. role == 'child', familyId == parent uid
//   stories/{storyId}      owned by the parent: userId == familyId == parent uid
//
// Invariants enforced here:
//   * Deny by default.
//   * role and familyId are immutable from clients; nobody can self-register as a
//     child or join another family by typing a familyId.
//   * No account can read or mutate another family's profiles or stories.
//   * Approval/publication fields (status = approved, isPublished = true, approvedAt,
//     approvedBy, publishedAt) can ONLY be written by the server (Admin SDK) through
//     /api/stories/[id]/approve, which requires a freshly re-authenticated parent.
//     Clients may only move a story to draft / review_required (e.g. after edits).
//   * Server-managed collections (usage, auditLog, legacy audios writes) are closed
//     to clients.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Restricted Child Mode identity minted by /api/child-mode/enter (custom token claims).
    function isChildMode() {
      return signedIn()
        && request.auth.token.get('dtRole', '') == 'child_mode'
        && request.auth.token.get('familyId', '') is string
        && request.auth.token.get('childId', '') is string;
    }

    function notChildMode() {
      return request.auth.token.get('dtRole', '') != 'child_mode';
    }

    function myProfilePath() {
      return /databases/$(database)/documents/users/$(uid());
    }

    function isParent() {
      return signedIn()
        && notChildMode()
        && exists(myProfilePath())
        && get(myProfilePath()).data.role == 'parent'
        && get(myProfilePath()).data.familyId == uid();
    }

    // Fields only the server may set or change.
    function serverManagedUserKeys() {
      return ['role', 'familyId', 'id', 'subscription', 'entitlements', 'usage', 'deletedAt'];
    }

    function approvalKeys() {
      return ['status', 'isPublished', 'approvedAt', 'approvedBy', 'publishedAt', 'approvedVersion'];
    }

    // Content whose change invalidates a previous parental approval.
    function reviewedContentKeys() {
      return ['title', 'content', 'excerpt', 'audioUrl', 'audioPath', 'imageUrl', 'childId', 'scenes', 'videoUrl'];
    }

    function clientStatus(status) {
      return status in ['draft', 'review_required'];
    }

    function childBelongsToMe(childId) {
      return exists(/databases/$(database)/documents/users/$(childId))
        && get(/databases/$(database)/documents/users/$(childId)).data.role == 'child'
        && get(/databases/$(database)/documents/users/$(childId)).data.familyId == uid();
    }

    function boundedString(value, max) {
      return value is string && value.size() <= max;
    }

    // ---------------------------------------------------------------- users
    match /users/{userId} {
      // Own profile, or a child profile that belongs to my family.
      allow read: if signedIn() && notChildMode() && (
        userId == uid()
        || (resource.data.role == 'child' && resource.data.familyId == uid())
      );

      // Child Mode may read only its own child profile.
      allow read: if isChildMode()
        && userId == request.auth.token.childId
        && resource.data.role == 'child'
        && resource.data.familyId == request.auth.token.familyId;

      // Self-registration: parent accounts only, family = own uid.
      allow create: if signedIn()
        && notChildMode()
        && userId == uid()
        && request.resource.data.role == 'parent'
        && request.resource.data.familyId == uid()
        && boundedString(request.resource.data.get('displayName', ''), 80)
        && !request.resource.data.keys().hasAny(['subscription', 'entitlements', 'usage', 'deletedAt']);

      // Parent creates a child profile (not an auth account) inside their own family.
      allow create: if isParent()
        && userId != uid()
        && request.resource.data.role == 'child'
        && request.resource.data.familyId == uid()
        && boundedString(request.resource.data.get('name', request.resource.data.get('displayName', '')), 60)
        && !request.resource.data.keys().hasAny(['subscription', 'entitlements', 'usage', 'email', 'password']);

      // Own profile edits, never role/family/billing fields.
      allow update: if signedIn()
        && notChildMode()
        && userId == uid()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverManagedUserKeys());

      // Parent edits a child profile in their family; ownership fields are immutable.
      allow update: if isParent()
        && userId != uid()
        && resource.data.role == 'child'
        && resource.data.familyId == uid()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverManagedUserKeys());

      // Parents may delete their own children's profiles. Deleting the parent account
      // itself must go through the server so stories, media and children are erased.
      allow delete: if isParent()
        && userId != uid()
        && resource.data.role == 'child'
        && resource.data.familyId == uid();
    }

    // -------------------------------------------------------------- stories
    match /stories/{storyId} {
      function ownsStory() {
        return signedIn() && notChildMode() && (resource.data.familyId == uid() || resource.data.userId == uid());
      }

      allow read: if ownsStory();

      // Child Mode: only this family's server-approved, published stories. Queries must
      // constrain familyId, status and isPublished (see getChildVisibleStories).
      allow read: if isChildMode()
        && resource.data.familyId == request.auth.token.familyId
        && resource.data.status == 'approved'
        && resource.data.isPublished == true;

      allow create: if isParent()
        && request.resource.data.userId == uid()
        && request.resource.data.familyId == uid()
        && clientStatus(request.resource.data.get('status', 'review_required'))
        && request.resource.data.get('isPublished', false) == false
        && !request.resource.data.keys().hasAny(['approvedAt', 'approvedBy', 'publishedAt', 'approvedVersion'])
        && boundedString(request.resource.data.get('title', ''), 200)
        && boundedString(request.resource.data.get('content', ''), 40000)
        && (!('childId' in request.resource.data)
            || request.resource.data.childId == null
            || childBelongsToMe(request.resource.data.childId));

      allow update: if isParent()
        && resource.data.familyId == uid()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.familyId == resource.data.familyId
        && boundedString(request.resource.data.get('title', ''), 200)
        && boundedString(request.resource.data.get('content', ''), 40000)
        // Clients can never grant approval or publication.
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(approvalKeys())
          || (clientStatus(request.resource.data.get('status', 'review_required'))
              && request.resource.data.get('isPublished', false) == false)
        )
        // Changing reviewed content always withdraws the approval.
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(reviewedContentKeys())
          || (clientStatus(request.resource.data.get('status', 'review_required'))
              && request.resource.data.get('isPublished', false) == false)
        )
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['childId'])
            || request.resource.data.childId == null
            || childBelongsToMe(request.resource.data.childId));

      allow delete: if isParent() && resource.data.familyId == uid();
    }

    // Legacy narration index written by the retired /api/upload_audio endpoint.
    match /audios/{audioId} {
      allow read: if signedIn() && resource.data.userId == uid();
      allow write: if false;
    }

    // Public contact form: create-only, bounded, unreadable from clients.
    match /contactMessages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'message', 'createdAt', 'status'])
        && boundedString(request.resource.data.get('name', ''), 120)
        && boundedString(request.resource.data.get('email', ''), 254)
        && boundedString(request.resource.data.get('subject', ''), 200)
        && boundedString(request.resource.data.message, 5000)
        && request.resource.data.status == 'new';
      allow read, update, delete: if false;
    }

    // Server-only: quota counters, audit trail, moderation queues, media jobs.
    match /parentSecrets/{document=**} {
      allow read, write: if false;
    }
    match /usage/{document=**} {
      allow read, write: if false;
    }
    match /auditLog/{document=**} {
      allow read, write: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
