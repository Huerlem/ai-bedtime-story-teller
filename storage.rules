rules_version = '2';

// Dream Tales V2 — Cloud Storage security rules
//
// * Deny by default; no public paths.
// * Each family can only read/write its own objects.
// * Uploads are bounded by size and content type.
// * Generated media for the Story-to-Video / illustration pipeline lives under
//   families/{familyId}/... and is written only by the server (Admin SDK).
//
// IMPORTANT: Firebase download URLs (getDownloadURL) embed a long-lived access
// token that bypasses these rules. Objects published with makePublic() by the
// retired /api/upload_audio endpoint also bypass them. See
// scripts/audit-public-audio.sh and docs/SECURITY_AUDIT_2026-11-17.md.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isImage(maxBytes) {
      return request.resource.size < maxBytes
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }

    function isNarration(maxBytes) {
      return request.resource.size < maxBytes
        && request.resource.contentType.matches('audio/(mpeg|mp3)');
    }

    function childInMyFamily(childId) {
      return firestore.exists(/databases/(default)/documents/users/$(childId))
        && firestore.get(/databases/(default)/documents/users/$(childId)).data.role == 'child'
        && firestore.get(/databases/(default)/documents/users/$(childId)).data.familyId == request.auth.uid;
    }

    // Narration generated client-side via the authenticated /api/tts route.
    match /audio/{userId}/{fileName} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId && isNarration(10 * 1024 * 1024);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /profile-images/{userId}/{fileName} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId && isImage(5 * 1024 * 1024);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /child-profiles/{childId}/{fileName} {
      allow read, delete: if signedIn() && childInMyFamily(childId);
      allow create, update: if signedIn() && childInMyFamily(childId) && isImage(5 * 1024 * 1024);
    }

    // Server-generated illustrations, scenes and video renders.
    match /families/{familyId}/{allPaths=**} {
      allow read: if signedIn() && request.auth.uid == familyId;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
